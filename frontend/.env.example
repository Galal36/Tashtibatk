# Internal Django origin (server-to-server, never exposed to the browser)
API_INTERNAL_URL=
# Public site origin (used for canonical/hreflang absolute URLs)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_COUNTRY=
# Contact / CTA — REPLACE with the real Kuwait numbers before launch
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
# Shared secret with Django's revalidate webhook
REVALIDATE_SECRET=

# Browser-facing API base. Empty in prod (same-origin via nginx); Django origin in dev.
NEXT_PUBLIC_API_BASE=
