# ── Django ──────────────────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
# comma-separated origins of the Next.js frontend (for CORS/CSRF)
FRONTEND_ORIGINS=

# ── Database ────────────────────────────────────────────
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ── Site identity (clone-friendly: change these per country) ──
SITE_NAME=
SITE_COUNTRY=
SITE_COUNTRY_CODE=
SITE_DOMAIN=
DEFAULT_LOCALE=ar
LOCALES=ar,en,ur

# ── Revalidation webhook to Next.js (ISR) ───────────────
REVALIDATE_URL=
REVALIDATE_SECRET=

# ── Email (contact form) — fill when ready ──────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
CONTACT_NOTIFY_EMAIL=
