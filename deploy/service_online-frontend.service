# Next.js (Node) — Service Online frontend
# Build first:  cd frontend && npm ci && npm run build
# Install: sudo cp deploy/service_online-frontend.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now service_online-frontend
[Unit]
Description=Service Online - Frontend (Next.js)
After=network.target service_online-backend.service

[Service]
Type=simple
User=moga
Group=moga
WorkingDirectory=/var/www/moga/apps/service_online/frontend
Environment=NODE_ENV=production
Environment=PORT=3010
ExecStart=/usr/bin/node /var/www/moga/apps/service_online/frontend/node_modules/.bin/next start -p 3010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
