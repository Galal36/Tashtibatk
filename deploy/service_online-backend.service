# Django (Gunicorn) — Service Online backend
# Install: sudo cp deploy/service_online-backend.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now service_online-backend
[Unit]
Description=Service Online - Backend (Django/Gunicorn)
After=network.target postgresql.service

[Service]
Type=notify
User=moga
Group=moga
WorkingDirectory=/var/www/moga/apps/service_online/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/moga/apps/service_online/backend/venv/bin/gunicorn \
    config.wsgi:application \
    --bind 127.0.0.1:8012 \
    --workers 3 \
    --timeout 60
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
